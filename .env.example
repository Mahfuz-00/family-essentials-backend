APP_NAME="Family Essentials"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=family_essentials
DB_USERNAME=family_app
DB_PASSWORD=
DB_ADMIN_USERNAME=postgres
DB_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SMS_DRIVER=log
SMS_CODE_LENGTH=6
SMS_CODE_TTL_MINUTES=10
SMS_MAX_ATTEMPTS=5

FRONTEND_URL=http://localhost:5173

# --- Plans ---------------------------------------------------------------------
# Tier keys live in config/plans.php; caps there are ENFORCED by the API.
PLAN_DEFAULT_TIER=pilot
PLAN_ENFORCE=true

# --- Arrival notifications -----------------------------------------------------
LOCATION_NOTIFICATIONS_ENABLED=true
LOCATION_NOTIFICATION_COOLDOWN_MINUTES=60
LOCATION_NOTIFICATION_STALE_DWELL_HOURS=12
LOCATION_NUDGE_WINDOW_MINUTES=120

# --- Push delivery -------------------------------------------------------------
# log | fcm (Android) — log | apns | fcm (iOS).
# Both default to `log` so a clone runs without credentials.
PUSH_ANDROID=log
PUSH_IOS=log
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
PUSH_IOS_SOUND=arrival.caf

# --- Operations: health checks -------------------------------------------------
OPS_DB_LATENCY_WARN_MS=250
OPS_DB_LATENCY_FAIL_MS=1000
OPS_QUEUE_BACKLOG_WARN=100
OPS_QUEUE_BACKLOG_FAIL=5000
OPS_SCHEDULER_WARN_MINUTES=5
OPS_SCHEDULER_FAIL_MINUTES=30
OPS_DISK_FREE_WARN_PERCENT=15
OPS_DISK_FREE_FAIL_PERCENT=5
OPS_SAMPLE_INTERVAL_MINUTES=5
OPS_SAMPLE_RETENTION_DAYS=30

# --- Operations: backups -------------------------------------------------------
# Must NOT be the runtime role: FORCE ROW LEVEL SECURITY would make the dump empty.
BACKUP_DB_CONNECTION=pgsql_admin
BACKUP_DISK=local
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
BACKUP_DAILY_AT=02:30
BACKUP_RPO_HOURS=24
BACKUP_RTO_MINUTES=120
BACKUP_TIMEOUT_SECONDS=1800
# Path to pg_dump when the client tools are not on PATH.
BACKUP_PG_DUMP=pg_dump

VITE_APP_NAME="${APP_NAME}"
